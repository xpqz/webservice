:Namespace Api
⍝ Stark handlers: each takes the request and returns the response body.
⍝ Postgres builds every JSON document (see the *_doc views); a handler
⍝ checks its input, runs SQL with bind variables, and hands the result back.

    ⍝ Bind variable markers: text is wide (Unicode), numbers are integers
    T←':<C100000(Q):'
    I←':<I:'

    ∇ r←Health req
      {}#.Db.Do'SELECT 1'
      r←(status:'ok')
    ∇

⍝ ── Labels ──────────────────────────────────────────────────────────────

    ∇ r←ListLabels req
      r←#.Db.Doc(⊂'SELECT list_labels(',I,', ',I,')'),Page req
    ∇

    ∇ r←GetLabel req
      r←LabelNamed req.PathParams.name
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←CreateLabel req;name;id
      name←req.Payload Text'name'
      :If 0=≢name ⋄ r←'Label'Invalid req'name' 'missing_field' ⋄ →0 ⋄ :EndIf
      :Trap 500
          id←#.Db.Do('INSERT INTO labels (name, color, description) VALUES (',T,', coalesce(NULLIF(',T,', ''''), ''ededed''), NULLIF(',T,', '''')) RETURNING id')name(req.Payload Text'color')(req.Payload Text'description')
          req.SetStatus 201
          r←#.Db.Doc('SELECT doc FROM label_doc WHERE id = ',I)(⊃id)
      :Else
          r←'Label'Invalid req'name'(Unique ⍬)
      :EndTrap
    ∇

    ∇ r←UpdateLabel req;id
      :Trap 500
          id←#.Db.Do('WITH u AS (UPDATE labels SET name = coalesce(NULLIF(',T,', ''''), name), color = coalesce(NULLIF(',T,', ''''), color), description = coalesce(NULLIF(',T,', ''''), description) WHERE lower(name) = lower(',T,') RETURNING id) SELECT id FROM u')(req.Payload Text'new_name')(req.Payload Text'color')(req.Payload Text'description')req.PathParams.name
      :Else
          r←'Label'Invalid req'name'(Unique ⍬) ⋄ →0
      :EndTrap
      :If 0=≢id ⋄ r←NotFound req ⋄ →0 ⋄ :EndIf
      r←#.Db.Doc('SELECT doc FROM label_doc WHERE id = ',I)(⊃id)
    ∇

    ∇ r←DeleteLabel req
      :If 0=≢#.Db.Do('WITH d AS (DELETE FROM labels WHERE lower(name) = lower(',T,') RETURNING id) SELECT id FROM d')req.PathParams.name
          r←NotFound req ⋄ →0
      :EndIf
      req.SetStatus 204
      r←''
    ∇

    ∇ r←LabelNamed name
      r←#.Db.Doc('SELECT doc FROM label_doc WHERE lower(name) = lower(',T,')')name
    ∇

⍝ ── Issues ──────────────────────────────────────────────────────────────

    ∇ r←ListIssues req;q;state
      q←req.QueryParams
      state←q Text'state'
      :If 0=≢state ⋄ state←'open' ⋄ :EndIf
      r←#.Db.Doc(⊂'SELECT list_issues(',T,', ',T,', ',I,', ',I,')'),state(q Text'labels'),Page req
    ∇

    ∇ r←GetIssue req
      r←Issue 0 Number req.PathParams.number
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←CreateIssue req;p;title;labels;n
      p←req.Payload
      title←p Text'title'
      labels←p Json'labels'
      :If 0=≢title ⋄ r←'Issue'Invalid req'title' 'missing_field' ⋄ →0 ⋄ :EndIf
      :If 0<UnknownLabels labels ⋄ r←'Issue'Invalid req'labels' 'invalid' ⋄ →0 ⋄ :EndIf
      n←⊃#.Db.Do('INSERT INTO issues (title, body) VALUES (',T,', NULLIF(',T,', '''')) RETURNING number')title(p Text'body')
      SetLabels n labels'true'
      req.SetStatus 201
      r←Issue n
    ∇

    ∇ r←UpdateIssue req;p;n;state;reason;labels
      n←0 Number req.PathParams.number
      p←req.Payload
      state←p Text'state'
      reason←p Text'state_reason'
      labels←p Json'labels'
      :If ~(⊂state)∊'' 'open' 'closed' ⋄ r←'Issue'Invalid req'state' 'invalid' ⋄ →0 ⋄ :EndIf
      :If ~(⊂reason)∊'' 'completed' 'not_planned' 'duplicate' 'reopened' ⋄ r←'Issue'Invalid req'state_reason' 'invalid' ⋄ →0 ⋄ :EndIf
      :If 0<UnknownLabels labels ⋄ r←'Issue'Invalid req'labels' 'invalid' ⋄ →0 ⋄ :EndIf
      :If 0=⊃⊃#.Db.Do('SELECT update_issue(',I,', ',T,', ',T,', ',T,', ',T,')')n(p Text'title')(p Text'body')state reason
          r←NotFound req ⋄ →0
      :EndIf
      SetLabels n labels'true'
      r←Issue n
    ∇

    ∇ r←ListIssueLabels req
      r←Issue 0 Number req.PathParams.number
      :If r≡⍬ ⋄ r←NotFound req ⋄ :Else ⋄ r←r.labels ⋄ :EndIf
    ∇

    ∇ r←AddIssueLabels req;n;labels
      n←0 Number req.PathParams.number
      labels←req.Payload Json'labels'
      :If ⍬≡Issue n ⋄ r←NotFound req ⋄ →0 ⋄ :EndIf
      :If 0<UnknownLabels labels ⋄ r←'Issue'Invalid req'labels' 'invalid' ⋄ →0 ⋄ :EndIf
      SetLabels n labels'false'
      r←(Issue n).labels
    ∇

    ∇ r←RemoveIssueLabel req;n
      n←0 Number req.PathParams.number
      :If 0=≢#.Db.Do('WITH d AS (DELETE FROM issue_labels il USING labels l WHERE il.label_id = l.id AND il.issue_number = ',I,' AND lower(l.name) = lower(',T,') RETURNING 1) SELECT 1 FROM d')n req.PathParams.name
          r←NotFound req ⋄ →0
      :EndIf
      r←(Issue n).labels
    ∇

    ∇ r←Issue n
    ⍝ The issue's document, or ⍬ if there is no such issue
      r←#.Db.Doc('SELECT doc FROM issue_doc WHERE number = ',I)n
    ∇

    ∇ n←UnknownLabels labels
    ⍝ How many of the label names (JSON text) don't exist
      n←0
      →0/⍨0=≢labels
      n←⊃⊃#.Db.Do('SELECT set_issue_labels(NULL, CAST(',T,' AS json), false)')labels
    ∇

    ∇ SetLabels(n labels replace)
    ⍝ replace is 'true' (labels become exactly these) or 'false' (add these)
      →0/⍨0=≢labels
      {}#.Db.Do('SELECT set_issue_labels(',I,', CAST(',T,' AS json), ',replace,')')n labels
    ∇

⍝ ── Comments ────────────────────────────────────────────────────────────

    ∇ r←ListComments req;n
      n←0 Number req.PathParams.number
      :If ⍬≡Issue n ⋄ r←NotFound req ⋄ →0 ⋄ :EndIf
      r←#.Db.Doc(⊂'SELECT list_comments(',I,', ',I,', ',I,')'),n,Page req
    ∇

    ∇ r←CreateComment req;n;body;id
      n←0 Number req.PathParams.number
      body←req.Payload Text'body'
      :If ⍬≡Issue n ⋄ r←NotFound req ⋄ →0 ⋄ :EndIf
      :If 0=≢body ⋄ r←'IssueComment'Invalid req'body' 'missing_field' ⋄ →0 ⋄ :EndIf
      id←⊃#.Db.Do('INSERT INTO comments (issue_number, body) VALUES (',I,', ',T,') RETURNING id')n body
      req.SetStatus 201
      r←#.Db.Doc('SELECT doc FROM comment_doc WHERE id = ',I)id
    ∇

⍝ ── Helpers ─────────────────────────────────────────────────────────────

    ∇ v←ns Text name
    ⍝ A text field from a JSON body or query string; '' when absent, null or not text
      v←''
      →0/⍨9≠⎕NC'ns'
      →0/⍨2≠⌊ns.⎕NC⊂name
      v←ns⍎name
      v←(((⍴⍴v)∊0 1)∧0=10|⎕DR v)/,v
    ∇

    ∇ j←ns Json name
    ⍝ A field from a JSON body, as JSON text again; '' when absent
      j←''
      →0/⍨9≠⎕NC'ns'
      →0/⍨2≠⌊ns.⎕NC⊂name
      j←1 ⎕JSON ns⍎name
    ∇

    ∇ n←default Number text
    ⍝ A positive integer of up to 9 digits, or the default
      n←default
      text←,text
      →0/⍨(0=≢text)∨(9<≢text)∨~∧/text∊⎕D
      n←⍎text
      :If n<1 ⋄ n←default ⋄ :EndIf
    ∇

    ∇ r←Page req;q;per
    ⍝ GitHub pagination: per_page (default 30, at most 100) and page (default 1)
      q←req.QueryParams
      per←100⌊30 Number q Text'per_page'
      r←per,per×(1 Number q Text'page')-1
    ∇

    ∇ code←Unique dummy
    ⍝ The GitHub error code for the SQL error being handled
      code←'invalid'
      :If '23505'≡⎕DMX.Message ⋄ code←'already_exists' ⋄ :EndIf
    ∇

    ∇ r←NotFound req
      req.Fail 404
      r←(message:'Not Found')
    ∇

    ∇ r←resource Invalid(req field code);e
      req.Fail 422
      r←(message:'Validation Failed' ⋄ errors:⍬)
      e←⎕NS'' ⋄ e.(resource field code)←resource field code
      r.errors←,⊂e
    ∇

    ∇ r←err ServerError req
    ⍝ Any error in a handler: log it for `docker compose logs`, answer 500
      ⍞←'ERROR ',req.Method,' ',req.Endpoint,': ',err.EM,' ',err.Message,' ',(⍕err.EN),⎕UCS 10
      r←(message:'Server Error')
    ∇

    ∇ r←fail FailBody req
    ⍝ Stark's own 404/405 bodies, in GitHub's shape
      r←(message:fail.body.detail)
    ∇

:EndNamespace
