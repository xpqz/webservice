:Namespace Api
⍝ Stark handlers: each takes the request and returns the response body.
⍝ Postgres builds every JSON document (see the *_doc views); a handler
⍝ checks its input, runs SQL with bind variables, and hands the result back.

    ⍝ Bind variable markers: text is wide (Unicode), numbers are integers
    T←':<C140000(Q):'   ⍝ room for 65536 characters as UTF-16, surrogate pairs included
    I←':<I:'
    J←'CAST(NULLIF(:<C140000(Q):, '''') AS json)'   ⍝ a JSON array, or NULL when absent

    ∇ r←Health req
      {}#.Db.Do'SELECT 1'
      r←(status:'ok')
    ∇

⍝ ── Labels ──────────────────────────────────────────────────────────────

    ∇ r←ListLabels req
      r←#.Db.Doc(⊂'SELECT list_labels(',I,', ',I,')'),Page req
    ∇

    ∇ r←GetLabel req
      r←LabelNamed req.PathParams.name
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←CreateLabel req;p;name
      p←req.Payload
      name←p Text'name'
      :If 0=≢name ⋄ r←'Label'Invalid req'name' 'missing_field' ⋄ →0 ⋄ :EndIf
      :Trap 500
          r←#.Db.Doc('SELECT create_label(',T,', ',T,', ',T,')')name(p Text'color')(p Text'description')
          req.SetStatus 201
      :Else
          r←'Label'Invalid req'name'(Unique ⍬)
      :EndTrap
    ∇

    ∇ r←UpdateLabel req;p
      p←req.Payload
      :Trap 500
          r←#.Db.Doc('SELECT update_label(',T,', ',T,', ',T,', ',T,')')req.PathParams.name(p Text'new_name')(p Text'color')(p Text'description')
      :Else
          r←'Label'Invalid req'name'(Unique ⍬) ⋄ →0
      :EndTrap
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←DeleteLabel req
      :If 0=≢#.Db.Do('WITH d AS (DELETE FROM labels WHERE lower(name) = lower(',T,') RETURNING id) SELECT id FROM d')req.PathParams.name
          r←NotFound req ⋄ →0
      :EndIf
      req.SetStatus 204
      r←''
    ∇

    ∇ r←LabelNamed name
      r←#.Db.Doc('SELECT doc FROM label_doc WHERE lower(name) = lower(',T,')')name
    ∇

⍝ ── Issues ──────────────────────────────────────────────────────────────

    ∇ r←ListIssues req;q;state
      q←req.QueryParams
      state←q Text'state'
      :If 0=≢state ⋄ state←'open' ⋄ :EndIf
      r←#.Db.Doc(⊂'SELECT list_issues(',T,', ',T,', ',T,', ',I,', ',I,')'),state(q Text'labels')(q Text'sort'),Page req
    ∇

    ∇ r←GetIssue req
      r←Issue 0 Number req.PathParams.number
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←CreateIssue req;p;title;labels
      p←req.Payload
      title←p Text'title'
      labels←p Json'labels'
      :If 0=≢title ⋄ r←'Issue'Invalid req'title' 'missing_field' ⋄ →0 ⋄ :EndIf
      :Trap 500
          r←#.Db.Doc('SELECT create_issue(',T,', ',T,', ',J,')')title(p Text'body')labels
          req.SetStatus 201
      :Else
          r←'Issue'Invalid req'labels' 'invalid'
      :EndTrap
    ∇

    ∇ r←UpdateIssue req;p;n;state;reason;labels
      n←0 Number req.PathParams.number
      p←req.Payload
      state←p Text'state'
      reason←p Text'state_reason'
      labels←p Json'labels'
      :If ~(⊂state)∊'' 'open' 'closed' ⋄ r←'Issue'Invalid req'state' 'invalid' ⋄ →0 ⋄ :EndIf
      :If ~(⊂reason)∊'' 'completed' 'not_planned' 'duplicate' 'reopened' ⋄ r←'Issue'Invalid req'state_reason' 'invalid' ⋄ →0 ⋄ :EndIf
      :Trap 500
          r←#.Db.Doc('SELECT update_issue(',I,', ',T,', ',T,', ',T,', ',T,', ',J,')')n(p Text'title')(p Text'body')state reason labels
      :Else
          r←'Issue'Invalid req'labels' 'invalid' ⋄ →0
      :EndTrap
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←ListIssueLabels req
      r←Issue 0 Number req.PathParams.number
      :If r≡⍬ ⋄ r←NotFound req ⋄ :Else ⋄ r←r.labels ⋄ :EndIf
    ∇

    ∇ r←AddIssueLabels req;n;labels
      n←0 Number req.PathParams.number
      labels←req.Payload Json'labels'
      :Trap 500
          r←#.Db.Doc('SELECT set_issue_labels(',I,', ',J,', false)')n labels
      :Else
          r←'Issue'Invalid req'labels' 'invalid' ⋄ →0
      :EndTrap
      :If r≡⍬ ⋄ r←NotFound req ⋄ :Else ⋄ r←r.labels ⋄ :EndIf
    ∇

    ∇ r←RemoveIssueLabel req;n
      n←0 Number req.PathParams.number
      r←#.Db.Doc('SELECT remove_issue_label(',I,', ',T,')')n req.PathParams.name
      :If r≡⍬ ⋄ r←NotFound req ⋄ :Else ⋄ r←r.labels ⋄ :EndIf
    ∇

    ∇ r←Issue n
    ⍝ The issue's document, or ⍬ if there is no such issue
      r←#.Db.Doc('SELECT doc FROM issue_doc WHERE number = ',I)n
    ∇

⍝ ── Comments ────────────────────────────────────────────────────────────

    ∇ r←ListComments req;n
      n←0 Number req.PathParams.number
      r←#.Db.Doc(⊂'SELECT list_comments(number, ',I,', ',I,') FROM issues WHERE number = ',I),(Page req),n
      :If r≡⍬ ⋄ r←NotFound req ⋄ :EndIf
    ∇

    ∇ r←CreateComment req;body
      body←req.Payload Text'body'
      :If 0=≢body ⋄ r←'IssueComment'Invalid req'body' 'missing_field' ⋄ →0 ⋄ :EndIf
      r←#.Db.Doc('SELECT create_comment(',I,', ',T,')')(0 Number req.PathParams.number)body
      :If r≡⍬ ⋄ r←NotFound req ⋄ →0 ⋄ :EndIf
      req.SetStatus 201
    ∇

⍝ ── Helpers ─────────────────────────────────────────────────────────────

    ∇ v←ns Text name
    ⍝ A text field from a JSON body or query string: '' when absent or null.
    ⍝ A value that isn't text, or is longer than GitHub allows, is a 422.
      v←''
      →0/⍨9≠⎕NC'ns'
      →0/⍨0=⌊ns.⎕NC⊂name
      v←ns⍎name
      :If v≡⊂'null' ⋄ v←'' ⋄ →0 ⋄ :EndIf      ⍝ how Jarvis reads JSON null
      :If (1<≢⍴v)∨(0≠10|⎕DR v)∨65536<≢v ⋄ BadField name ⋄ :EndIf
      v←'',,v
    ∇

    ∇ j←ns Json name;v
    ⍝ A field that must be an array of strings, as JSON text; '' when absent
      j←''
      →0/⍨9≠⎕NC'ns'
      →0/⍨0=⌊ns.⎕NC⊂name
      v←ns⍎name
      :If ~(1=≢⍴v)∧(v≡⍬)∨(326=⎕DR v)∧∧/{(1=≢⍴⍵)∧0=10|⎕DR ⍵}¨v ⋄ BadField name ⋄ :EndIf
      j←1 ⎕JSON v
    ∇

    ∇ BadField name
    ⍝ Ends the request with a 422 on this field (see ServerError)
      ⎕SIGNAL⊂('EN' 422)('Message' name)
    ∇

    ∇ n←default Number text
    ⍝ A positive integer of up to 9 digits, or the default
      n←default
      text←,text
      →0/⍨(0=≢text)∨(9<≢text)∨~∧/text∊⎕D
      n←⍎text
      :If n<1 ⋄ n←default ⋄ :EndIf
    ∇

    ∇ r←Page req;q;per
    ⍝ GitHub pagination: per_page (default 30, at most 100) and page (default 1)
      q←req.QueryParams
      per←100⌊30 Number q Text'per_page'
      r←per,per×(1 Number q Text'page')-1
    ∇

    ∇ code←Unique dummy
    ⍝ The GitHub error code for the SQL error being handled
      code←'invalid'
      :If '23505'≡⎕DMX.Message ⋄ code←'already_exists' ⋄ :EndIf
    ∇

    ∇ r←NotFound req
      req.Fail 404
      r←(message:'Not Found')
    ∇

    ∇ r←resource Invalid(req field code)
      req.Fail 422
      r←(message: 'Validation Failed' ⋄ errors: ⍬)
      r.errors,←(resource: resource ⋄ field: field ⋄ code: code)
    ∇

    ∇ r←err ServerError req;resource
    ⍝ A bad field (EN 422, from BadField): GitHub's validation error.
    ⍝ Any other error in a handler: log it for `docker compose logs`, answer 500.
      :If 422=err.EN
          resource←'Issue'
          :If '/labels'≡7↑req.Route ⋄ resource←'Label' ⋄ :EndIf
          :If ∨/'/comments'⍷req.Route ⋄ resource←'IssueComment' ⋄ :EndIf
          r←resource Invalid req err.Message'invalid' ⋄ →0
      :EndIf
      ⍞←'ERROR ',req.Method,' ',req.Endpoint,': ',err.EM,' ',err.Message,' ',(⍕err.EN),⎕UCS 10
      r←(message:'Server Error')
    ∇

    ∇ r←fail FailBody req
    ⍝ Stark's own 404/405 bodies, in GitHub's shape
      r←(message:fail.body.detail)
    ∇

:EndNamespace
